# REFERENCE ONLY. The app does not read a .env file automatically.
# Set these in your terminal before starting a program, e.g. in PowerShell:
#     $env:SOC_DEMO_MODE = "1"
# Never put real keys in this file or in git.

# ---- Backend behaviour ------------------------------------------------------
SOC_API_KEY=                 # if set, POST endpoints need header  X-API-Key: <value>
SOC_DEMO_MODE=0              # 1 = enable /demo/tamper (attack simulation) - demos only
SOC_DB_PATH=                 # default: backend/data/soc.db
SOC_MAX_PENDING=10000        # max un-sealed logs
SOC_CHAIN_ENABLED=true       # false = run without a blockchain (everything shows UNVERIFIABLE)
SOC_CHAIN_MODE=real          # real = Hardhat/Sepolia node, simulated = built-in demo ledger (no node needed)

# ---- Detection tuning -------------------------------------------------------
SOC_BRUTE_FORCE_THRESHOLD=3
SOC_BRUTE_FORCE_WINDOW_MIN=5
SOC_OFF_HOURS_START=22       # UTC hour
SOC_OFF_HOURS_END=6

# ---- Blockchain connection (backend) ----------------------------------------
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_PRIVATE_KEY=           # set ONLY for signed transactions on a testnet (throwaway wallet!)

# ---- Hardhat (contracts/) for Sepolia ---------------------------------------
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=        # throwaway testnet wallet with Sepolia test ETH
